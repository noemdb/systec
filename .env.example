# Configuración base de SysTec GMB
# Copia este archivo a .env y ajusta los valores de tu entorno.

# Depuración (1 activa errores en pantalla; 0 para producción)
SYSTEC_DEBUG=0

# Rutas de almacenamiento (por defecto: storage/ y storage/db.db)
# SYSTEC_STORAGE=/ruta/a/storage
# SYSTEC_DB=/ruta/a/storage/db.db

# Conexión PostgreSQL legacy del sistema de bienes institucional (SIA)
# La consulta abre una transacción REPEATABLE READ READ ONLY.
SYSTEC_LEGACY_PG_HOST=localhost
SYSTEC_LEGACY_PG_PORT=5432
SYSTEC_LEGACY_PG_DATABASE=DATOS
SYSTEC_LEGACY_PG_USER=postgres
SYSTEC_LEGACY_PG_PASSWORD=postgres

# Credencial para redacción asistida por NVIDIA Build (opcional)
# API_KEY_NVIDIA_BUILD=nvapi-...
