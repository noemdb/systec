<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         verbose="true"
         convertDeprecationsToExceptions="true">
    <testsuites>
        <testsuite name="SysTec unit tests">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="display_errors" value="1"/>
    </php>
</phpunit>
